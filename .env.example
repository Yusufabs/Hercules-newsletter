# Copy to .env for local testing (never commit the real .env). In
# production these are set as GitHub Actions repo secrets instead --
# see .github/workflows/send-newsletter.yml.

# --- Recipients: hercules.works users (live DB pull, no CSV export step) ---
NEWSLETTER_DATA_SOURCE=api          # api | sample (sample is local-testing-only, never production)
HERCULES_API_BASE=
HERCULES_API_KEY=
POSEIDON_API_BASE=
POSEIDON_API_KEY=

# --- Recipients: external personnel CSV (top-level titles only) ---
NEWSLETTER_INCLUDE_PERSONNEL_CSV=true
PERSONNEL_CSV_PATH=sample_data/sample_personnel.csv   # point at the real file once you have it

# --- CTA link ---
# Fallback only. Each issue's UTM-tagged link goes in cta_url in
# content/weekly_content.json and takes precedence over this.
NEWSLETTER_CTA_URL=https://hercules.works/

# --- Sending ---
# gmail_smtp | sendgrid | brevo | mailchimp. For team test sends, use
# gmail_smtp -- your own Gmail/Workspace account, free, no signup -- see
# TESTING.md. Production is expected to move to sendgrid,
# domain-authenticated, once wired up for real (see README).
ESP_PROVIDER=gmail_smtp
ESP_API_KEY=                     # sendgrid / brevo only
FROM_EMAIL=you@hercules.works    # gmail_smtp: must be the exact mailbox the app password belongs to
FROM_NAME=Hercules.works
GMAIL_APP_PASSWORD=              # gmail_smtp only -- 16-char app password, see TESTING.md

# --- Illustration (placeholder until the real blog design is handed off) ---
NEWSLETTER_ILLUSTRATION_MODE=placeholder   # placeholder | brand_asset
BRAND_ILLUSTRATION_ASSET_URL=
# BRAND_ACCENT_COLOR=              # leave unset: config.py defaults to the real hercules.works colors

# --- Safety ---
NEWSLETTER_DRY_RUN=true              # set to false only for the real Thursday send

# --- Team test sends (python3 test_send.py) ---
# Comma-separated. Every address in test_recipients.json must be at one
# of these domains or the test send is refused.
TEST_ALLOWED_DOMAINS=
TEST_RECIPIENTS_PATH=test_recipients.json
