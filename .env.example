# Copy to .env for local testing (never commit the real .env). In
# production these are set as GitHub Actions repo secrets instead --
# see .github/workflows/send-newsletter.yml.

# --- Recipients (live hercules.works DB pull, no CSV export step) ---
NEWSLETTER_DATA_SOURCE=api          # api | sample (sample is local-testing-only, never production)
HERCULES_API_BASE=
HERCULES_API_KEY=
POSEIDON_API_BASE=
POSEIDON_API_KEY=

# --- Sending ---
ESP_PROVIDER=sendgrid
ESP_API_KEY=
FROM_EMAIL=newsletter@hercules.works
FROM_NAME=Hercules.works

# --- Illustration (placeholder until the real blog design is handed off) ---
NEWSLETTER_ILLUSTRATION_MODE=placeholder   # placeholder | brand_asset
BRAND_ILLUSTRATION_ASSET_URL=
BRAND_ACCENT_COLOR=#5B47F5

# --- Safety ---
NEWSLETTER_DRY_RUN=true              # set to false only for the real Thursday send
